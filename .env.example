# AI 招聘助手 — 全局环境变量（模板）
# 复制此文件为 .env 并填入真实值
# 端口全部从 18000 起

# LLM（必填）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 数据库（必填）
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/recruit_ai?charset=utf8mb4

# Agent 服务地址（可选，内联逻辑可自动降级）
RESUME_PARSER_URL=http://localhost:18001
CLASSIFIER_URL=http://localhost:18002
QUESTIONNAIRE_URL=http://localhost:18003
INTERVIEW_URL=http://localhost:18004
POLICY_RAG_URL=http://localhost:18005
NOTIFICATION_URL=http://localhost:18006
ANALYZER_BASE_URL=http://localhost:18008

# Embedding（必填，用于 RAG 向量化）
EMBEDDING_MODEL=text-embedding-3-small

# Milvus 向量数据库（必填，用于 RAG）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 邮件通知（可选）
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=your-email@163.com
SMTP_PASSWORD=your-smtp-password

# JWT（生产环境务必修改）
JWT_SECRET=change-this-to-a-random-secret-key

# Redis 语义缓存（可选）
REDIS_URL=redis://localhost:6379/0

# Dify（可选，用于考试分析）
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=
