# AI 招聘助手 — 全局环境变量（唯一配置源）
# 复制此文件为 .env 并填入真实值
# 所有服务（Backend / RAG Service）都从此处读取配置

# ===== LLM（必填） =====
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ===== 数据库（必填） =====
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/recruit_ai?charset=utf8mb4

# ===== Agent 服务地址（可选，内联逻辑可自动降级） =====
RESUME_PARSER_URL=http://localhost:18001
CLASSIFIER_URL=http://localhost:18002
QUESTIONNAIRE_URL=http://localhost:18003
INTERVIEW_URL=http://localhost:18004
POLICY_RAG_URL=http://localhost:18005
NOTIFICATION_URL=http://localhost:18006
ANALYZER_BASE_URL=http://localhost:18008

# ===== Embedding（必填，用于 RAG 向量化） =====
EMBEDDING_MODEL=text-embedding-3-small

# ===== Milvus 向量数据库（必填，用于 RAG） =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== 企业制度文档 =====
POLICY_DOCS_DIR=./policies

# ===== 邮件通知（可选） =====
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=your-email@163.com
SMTP_PASSWORD=your-smtp-password
NOTIFICATION_EMAIL_FROM=your-email@163.com

# ===== JWT 认证（生产环境务必修改） =====
# 生产环境请使用至少 32 字节的随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 外部考试平台回调验证（请求头：X-Webhook-Token）
EXAM_WEBHOOK_TOKEN=replace-with-a-separate-random-webhook-token

# ===== Redis 语义缓存（可选） =====
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL=86400
CACHE_SIMILARITY_THRESHOLD=0.92

# ===== Dify（可选，用于考试分析） =====
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=

# ===== RAG 参数（可选，保留默认值即可） =====
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50
HYBRID_DENSE_WEIGHT=1.0
HYBRID_SPARSE_WEIGHT=0.7
RETRIEVAL_TOP_K=10
RERANK_CANDIDATES_M=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 评分阈值（自动分流） =====
SCORE_THRESHOLD_FAST_TRACK=80.0
SCORE_THRESHOLD_QUESTIONNAIRE=60.0
SCORE_THRESHOLD_TALENT_POOL=40.0
