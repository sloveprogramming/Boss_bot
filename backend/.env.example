# 数据库
DATABASE_URL=sqlite:///./recruit.db

# LLM API 配置（支持 OpenAI 兼容接口）
# 使用 DeepSeek（兼容 OpenAI 接口）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-8636aba6ce8c4a2c978eac7356f21732
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Embedding 模型（用于 RAG）
EMBEDDING_MODEL=text-embedding-3-small

# 通知服务
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
NOTIFICATION_EMAIL_FROM=noreply@recruitai.com

# SMS（可选）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 面试官默认日历（可选）
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# 企业制度文档目录
POLICY_DOCS_DIR=./policies

# JWT 认证
JWT_SECRET=your-random-secret-key-change-in-production

# Redis（用于语义缓存）
REDIS_URL=redis://localhost:6379/0
